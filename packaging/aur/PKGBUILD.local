# Maintainer: Wang Yinyou <140365984+wyyyz1937365497@users.noreply.github.com>
# Local-only PKGBUILD: source tarball is placed next to this file.
pkgname=wallkeep
pkgver=0.2.0
pkgrel=1
pkgdesc="Local-first wallpaper library; optional X sync is downloaded by gallery-dl"
arch=('any')
url="https://github.com/wyyyz1937365497/wallkeep"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'python-pillow'
    'python-numpy'
    'python-requests'
    'python-secretstorage'
    'gallery-dl'
    'ffmpeg'
    'imagemagick'
    'qt6-svg'
)
optdepends=(
    'mpvpaper: dynamic video wallpapers'
    'yt-dlp: download videos from X'
    'quickshell: end-4 shell wallpaper switching'
    'matugen: shell color generation'
)
makedepends=(
    'uv'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    uv build --wheel
}

package() {
    cd "$pkgname-$pkgver"
    site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
    install -d "$pkgdir$site"
    python -m zipfile -e dist/*.whl "$pkgdir$site"
    install -d "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/wallkeep" <<'EOF'
#!/usr/bin/python3
import sys
from wallkeep.app import main

if __name__ == "__main__":
    sys.exit(main())
EOF
    chmod 755 "$pkgdir/usr/bin/wallkeep"
    install -Dm644 packaging/wallkeep.desktop \
        "$pkgdir/usr/share/applications/wallkeep.desktop"
}
